    },
    "No camera login saved. Add the cameras' admin login in Setup, under PTZ cameras." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Kamera-Login gespeichert. Trag den Admin-Login der Kameras in der Einrichtung unter Kameras ein."
          }
        }
      }
    },
    "That camera isn't set up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kamera ist nicht eingerichtet."
          }
        }
      }
    },
    "The camera said: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera meldet: %@"
          }
        }
      }
    },
    "The camera turned down the saved login. Check the user name and password in Setup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera hat den gespeicherten Login abgelehnt. Prüf Benutzername und Passwort in der Einrichtung."
          }
        }
      }
    },
    "The camera wouldn't open a logged-in session (HTTP %lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera hat keine angemeldete Sitzung geöffnet (HTTP %lld)."
          }
        }
      }
    },
    "The switcher stopped answering" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mischer antwortet nicht mehr"
