{
  "sourceLanguage" : "en",
  "strings" : {
    "Another controller has the camera, so it wouldn't hand over control (%@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Steuerung hat die Kamera, deshalb gibt sie die Steuerung nicht ab (%@)."
          }
        }
      }
    },
    "Auto" : {
      "localizations" : {
