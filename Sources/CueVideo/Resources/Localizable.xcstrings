    "Auto tracking needs the camera's picture: a Canon camera, or an NDI picture set for its switcher input in Setup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Verfolgung braucht das Bild der Kamera: eine Canon-Kamera oder ein NDI-Bild, das in der Einrichtung für ihren Mischer-Eingang gewählt ist."
          }
