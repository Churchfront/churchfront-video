    "%@. Reconnecting on its own; buttons do nothing until it's back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Verbindet sich von selbst neu; bis dahin tun die Tasten nichts."
          }
        }
      }
    },
    "%@. Space, Return and the number keys do nothing here, so they can't cut or fade." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Leertaste, Return und die Zahlentasten tun hier nichts, damit nichts versehentlich geschnitten oder geblendet wird."
          }
        }
      }
    },
    "%@: drop a source here to put it live, or drag this onto a destination" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
