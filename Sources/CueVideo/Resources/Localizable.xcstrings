    "Camera speed for the joystick, zoom and arrow keys. Slow it down for fine framing on a tight shot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera-Tempo für Joystick, Zoom und Pfeiltasten. Langsamer für feines Ausrichten bei engen Einstellungen."
          }
        }
      }
    },
