    },
    "What this is for" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wofür das ist"
          }
        }
      }
    },
    "Where the ATEM is, and which mix the operator runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
